#!/bin/bash
# GuSi Music — 设置变更回调：持久化 fnOS 下发的授权目录快照并做权限诊断
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TRIM_PKGVAR="${TRIM_PKGVAR:-/tmp/gusi-music}"

# root 生命周期降权交接（与 cmd/main 同款防御）
if [ "$(id -u 2>/dev/null || printf 1)" -eq 0 ] && [ "${GUSI_HANDOFF:-0}" != "1" ]; then
  if [ -n "${TRIM_USERNAME:-}" ] && command -v runuser >/dev/null 2>&1; then
    gusi_pkg_uid="$(id -u "${TRIM_USERNAME}" 2>/dev/null || true)"
    case "${gusi_pkg_uid}" in
      ''|0|*[!0-9]*) : ;;
      *)
        exec runuser -u "${TRIM_USERNAME}" -- env \
          GUSI_HANDOFF=1 TRIM_UID="${gusi_pkg_uid}" TRIM_RUN_USERNAME="${TRIM_USERNAME}" \
          /bin/bash "${SCRIPT_DIR}/config_callback" "$@"
        ;;
    esac
  fi
fi

LOG_FILE="${TRIM_PKGVAR}/info.log"
ACCESS_SNAPSHOT_FILE="${TRIM_PKGVAR}/accessible-paths.env"

# shellcheck source=/dev/null
. "${SCRIPT_DIR}/runtime_bootstrap.sh"
# shellcheck source=/dev/null
. "${SCRIPT_DIR}/runtime_privilege.sh"
# shellcheck source=/dev/null
. "${SCRIPT_DIR}/runtime_access.sh"

assert_package_identity || exit 1

ensure_managed_file_writable "${LOG_FILE}" || true

log_msg() {
  local message="$1"
  local stamp
  stamp="$(date '+%Y-%m-%d %H:%M:%S')"
  mkdir -p "${TRIM_PKGVAR}" >/dev/null 2>&1 || true
  rotate_log_file "${LOG_FILE}"
  printf '%s - %s\n' "${stamp}" "${message}" >> "${LOG_FILE}" 2>/dev/null || true
}

escape_single_quotes() {
  printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

persist_access_snapshot() {
  local raw_paths="$1"
  local target_dir
  target_dir="$(dirname "${ACCESS_SNAPSHOT_FILE}")"
  mkdir -p "${target_dir}" >/dev/null 2>&1 || true
  [ -d "${target_dir}" ] || return 1
  [ -w "${target_dir}" ] || return 1

  {
    echo "# Generated by cmd/config_callback at $(date '+%Y-%m-%d %H:%M:%S')"
    echo "TRIM_DATA_ACCESSIBLE_PATHS='$(escape_single_quotes "${raw_paths}")'"
  } > "${ACCESS_SNAPSHOT_FILE}.tmp" 2>/dev/null || return 1

  mv -f "${ACCESS_SNAPSHOT_FILE}.tmp" "${ACCESS_SNAPSHOT_FILE}" >/dev/null 2>&1 || return 1
  return 0
}

RAW_ACCESS_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}"
log_msg "Config callback received: TRIM_DATA_ACCESSIBLE_PATHS=${RAW_ACCESS_PATHS:-<empty>}"

if persist_access_snapshot "${RAW_ACCESS_PATHS}"; then
  log_msg "Accessible paths snapshot updated: ${ACCESS_SNAPSHOT_FILE}"
else
  log_msg "WARN: Failed to update accessible paths snapshot: ${ACCESS_SNAPSHOT_FILE}"
fi
log_accessible_paths_diagnostic "${RAW_ACCESS_PATHS}"

exit 0
