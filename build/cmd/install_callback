#!/bin/bash
# GuSi Music — 安装回调：身份校验、端口/管理密码持久化、运行时目录准备
# 向导字段：wizard_app_port（应用端口）、wizard_admin_password（管理密码）
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TRIM_PKGVAR="${TRIM_PKGVAR:-/tmp/gusi-music}"

# root 生命周期降权交接（与 cmd/main 同款防御）
if [ "$(id -u 2>/dev/null || printf 1)" -eq 0 ] && [ "${GUSI_HANDOFF:-0}" != "1" ]; then
  if [ -n "${TRIM_USERNAME:-}" ] && command -v runuser >/dev/null 2>&1; then
    gusi_pkg_uid="$(id -u "${TRIM_USERNAME}" 2>/dev/null || true)"
    case "${gusi_pkg_uid}" in
      ''|0|*[!0-9]*) : ;;
      *)
        exec runuser -u "${TRIM_USERNAME}" -- env \
          GUSI_HANDOFF=1 TRIM_UID="${gusi_pkg_uid}" TRIM_RUN_USERNAME="${TRIM_USERNAME}" \
          /bin/bash "${SCRIPT_DIR}/install_callback" "$@"
        ;;
    esac
  fi
fi

# shellcheck source=/dev/null
. "${SCRIPT_DIR}/runtime_bootstrap.sh"
# shellcheck source=/dev/null
. "${SCRIPT_DIR}/runtime_privilege.sh"
# shellcheck source=/dev/null
. "${SCRIPT_DIR}/runtime_data.sh"
# shellcheck source=/dev/null
. "${SCRIPT_DIR}/runtime_paths.sh"

LOG_FILE="${TRIM_PKGVAR}/info.log"
CONFIG_FILE="${TRIM_PKGVAR}/app-config.env"

log_msg() {
  local message="$1"
  local stamp
  stamp="$(date '+%Y-%m-%d %H:%M:%S')"
  mkdir -p "${TRIM_PKGVAR}" >/dev/null 2>&1 || true
  rotate_log_file "${LOG_FILE}"
  printf '%s - %s\n' "${stamp}" "${message}" >> "${LOG_FILE}" 2>/dev/null || true
  printf '%s - %s\n' "${stamp}" "${message}" >> "/tmp/gusi.music.install.log" 2>/dev/null || true
}

fail_with_message() {
  local message="$1"
  log_msg "INSTALL_ERROR: ${message}"
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "${message}" > "${TRIM_TEMP_LOGFILE}"
  exit 1
}

escape_single_quotes() {
  printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

trim_value() {
  echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

is_valid_port() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "${1}" -ge 1 ] && [ "${1}" -le 65535 ]
}

is_port_in_use() {
  if command -v ss >/dev/null 2>&1; then
    ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq ":${1}$" && return 0
  fi
  if command -v netstat >/dev/null 2>&1; then
    netstat -lnt 2>/dev/null | awk '{print $4}' | grep -Eq ":${1}$" && return 0
  fi
  return 1
}

write_config_file() {
  local target_file="$1"
  local target_dir
  local temp_file
  target_dir="$(dirname "${target_file}")"
  mkdir -p "${target_dir}" >/dev/null 2>&1 || return 1
  temp_file="${target_dir}/.app-config.$$.$RANDOM.tmp"
  {
    echo "# Generated by cmd/install_callback at $(date '+%Y-%m-%d %H:%M:%S')"
    echo "WIZARD_APP_PORT='$(escape_single_quotes "${APP_PORT_EFFECTIVE}")'"
    echo "GS_ADMIN_PASSWORD='$(escape_single_quotes "${ADMIN_PASSWORD_EFFECTIVE}")'"
  } > "${temp_file}" 2>/dev/null || {
    rm -f "${temp_file}" >/dev/null 2>&1 || true
    return 1
  }
  chmod 600 "${temp_file}" >/dev/null 2>&1 || true
  mv -f "${temp_file}" "${target_file}" >/dev/null 2>&1 || {
    rm -f "${temp_file}" >/dev/null 2>&1 || true
    return 1
  }
}

assert_package_identity || \
  fail_with_message "包身份校验失败：生命周期须以 fnOS 包专属用户运行（详见 ${LOG_FILE}）"

ensure_managed_file_writable "${LOG_FILE}" || true

# 端口：向导值 → 既有配置 → 安装档案 → 默认 43000
PREV_PORT=""
PREV_ADMIN_PASSWORD=""
if [ -f "${CONFIG_FILE}" ]; then
  # shellcheck source=/dev/null
  . "${CONFIG_FILE}" 2>/dev/null || true
  PREV_PORT="${WIZARD_APP_PORT:-}"
  PREV_ADMIN_PASSWORD="${GS_ADMIN_PASSWORD:-}"
fi
# 安装档案兜底：上一轮卸载若选择「删除数据」会清空 PKGVAR，端口偏好靠共享目录里的档案
# 跨「卸载 → 重装」保留，用户重装后无需再填一次端口。
PROFILE_FILE=""
if PROFILE_FILE="$(resolve_install_profile_file)"; then
  if [ -z "${PREV_PORT}" ] && [ -f "${PROFILE_FILE}" ]; then
    # shellcheck source=/dev/null
    . "${PROFILE_FILE}" 2>/dev/null || true
    PREV_PORT="${WIZARD_APP_PORT:-}"
  fi
fi

APP_PORT_EFFECTIVE="$(trim_value "${wizard_app_port:-}")"
if [ -z "${APP_PORT_EFFECTIVE}" ]; then
  APP_PORT_EFFECTIVE="${PREV_PORT:-43000}"
fi
if ! is_valid_port "${APP_PORT_EFFECTIVE}"; then
  fail_with_message "应用端口无效：${APP_PORT_EFFECTIVE}（仅支持 1-65535 的数字端口）"
fi
if is_port_in_use "${APP_PORT_EFFECTIVE}"; then
  fail_with_message "应用端口 ${APP_PORT_EFFECTIVE} 已被占用，请在安装向导中改用其他未占用端口后重试。"
fi

# 管理密码：向导值 → 既有配置 → 自动生成
ADMIN_PASSWORD_EFFECTIVE="$(printf '%s' "${wizard_admin_password:-}" | tr -d '\r\n')"
if [ -z "${ADMIN_PASSWORD_EFFECTIVE}" ]; then
  ADMIN_PASSWORD_EFFECTIVE="${PREV_ADMIN_PASSWORD:-}"
fi
if [ -z "${ADMIN_PASSWORD_EFFECTIVE}" ]; then
  ADMIN_PASSWORD_EFFECTIVE="$(head -c 12 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 12)"
  log_msg "Admin password auto-generated"
fi

# 运行时目录准备（私有 + 共享）
APP_SHARE_DIR="$(resolve_app_share_dir)"
prepare_package_runtime "${APP_SHARE_DIR}" || \
  fail_with_message "应用专用用户无法准备运行目录：${APP_SHARE_DIR}（详见 ${LOG_FILE}）"

write_config_file "${CONFIG_FILE}" || fail_with_message "写入应用配置失败：${CONFIG_FILE}"
# 卸载重装保留的安装档案（仅端口偏好；密码只存私有配置）
PERSIST_FILE=""
if PROFILE_FILE="$(resolve_install_profile_file)"; then
  PERSIST_FILE="${PROFILE_FILE}"
  mkdir -p "$(dirname "${PERSIST_FILE}")" >/dev/null 2>&1 || true
  {
    echo "# Generated by cmd/install_callback at $(date '+%Y-%m-%d %H:%M:%S')"
    echo "WIZARD_APP_PORT='$(escape_single_quotes "${APP_PORT_EFFECTIVE}")'"
  } > "${PERSIST_FILE}" 2>/dev/null || log_msg "WARN: failed to write persisted install profile: ${PERSIST_FILE}"
else
  log_msg "WARN: storage volume could not be resolved from fnOS environment; install profile not persisted"
fi

log_msg "Install config saved: app_port=${APP_PORT_EFFECTIVE}"
exit 0
