<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 纯色深色主题：壳自己只在「连接中 / 连不上 / 首次配置」时露脸，
         这三屏必须和 Web 应用同一套色，不能出现亮色闪屏。 -->
    <style name="Theme.GusiMusic" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_dim</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="GusiEdit">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textColorHint">@color/fg_dim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">textUri</item>
        <item name="android:imeOptions">actionDone</item>
    </style>

    <style name="GusiButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:minHeight">46dp</item>
    </style>

    <style name="GusiButton.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
