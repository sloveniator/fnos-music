<?xml version="1.0" encoding="utf-8"?>
<!-- WebView 在代码里创建（渲染进程被杀后要能整个重建），所以这里只是一个容器。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 连接中 -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading"
            android:textColor="@color/fg_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 连不上 / 渲染进程挂了 -->
    <LinearLayout
        android:id="@+id/error_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/err_title"
            android:textColor="@color/fg"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/err_desc"
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_retry"
                style="@style/GusiButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/err_retry" />

            <Button
                android:id="@+id/btn_change"
                style="@style/GusiButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/err_change" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
